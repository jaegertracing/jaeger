{
  "method": "POST",
  "path": "/jaeger-span-read/_search",
  "query": {
    "ignore_unavailable": [
      "true"
    ],
    "rest_total_hits_as_int": [
      "true"
    ]
  },
  "body": {
    "query": {
      "bool": {
        "must": [
          {
            "range": {
              "startTimeMillis": {
                "gte": 1577934245000,
                "lte": 1577937845000
              }
            }
          },
          {
            "range": {
              "startTime": {
                "gte": 1577934245000000,
                "lte": 1577937845000000
              }
            }
          },
          {
            "term": {
              "process.serviceName": "test-service"
            }
          }
        ]
      }
    },
    "search_after": [
      2000000,
      "000000000000000000000000000000ab",
      1577934245000000,
      "00000000000000cd",
      "index-1",
      "doc-1"
    ],
    "size": 3,
    "sort": [
      {
        "duration": {
          "order": "desc"
        }
      },
      {
        "traceID": {
          "order": "asc"
        }
      },
      {
        "startTime": {
          "order": "desc"
        }
      },
      {
        "spanID": {
          "order": "asc"
        }
      },
      {
        "_index": {
          "order": "desc"
        }
      },
      {
        "_id": {
          "order": "asc"
        }
      }
    ]
  }
}
