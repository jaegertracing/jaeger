{
  "name": "jaeger-ci-scripts",
  "version": "1.0.0",
  "description": "Jaeger CI scripts for managing pull request quotas and other automation tasks.",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "github",
    "pull-request",
    "quota",
    "management"
  ],
  "author": "Jaeger Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0"
  },
  "devDependencies": {
    "jest": "30.5.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "rootDir": "..",
    "coverageProvider": "v8",
    "coverageDirectory": "<rootDir>/scripts/coverage",
    "roots": [
      "<rootDir>/scripts",
      "<rootDir>/actions"
    ],
    "collectCoverageFrom": [
      "actions/pr-quota-manager/pr-quota-manager.js",
      "actions/pr-duplicates/pr-duplicates.js",
      "scripts/ci-summary-report-publish.js"
    ]
  }
}
