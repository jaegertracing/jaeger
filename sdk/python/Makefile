# This SDK is a prototype and is not tested by CI; run these targets from
# sdk/python. Its protobuf stubs are committed and are regenerated by the
# repository's own codegen — `make proto-api-v3-python` from the root, or `make
# proto` to refresh every language at once.
#
# The toolchain is uv, as in scripts/ai-sidecar/gemini. `uv run` syncs the
# environment from uv.lock before each command, so there is no bootstrap step.

# The gRPC runtime is an extra, so the tests have to ask for it.
UV := uv run --extra grpc

.PHONY: help
help:
	@echo "test  - run the tests"
	@echo "e2e   - run the end-to-end test against OpenSearch and a Jaeger from source"
	@echo "lint  - check formatting and lint rules"
	@echo "fmt   - apply formatting and import ordering"
	@echo "lock  - update uv.lock after changing dependencies"
	@echo "clean - remove caches and the environment"
	@echo
	@echo "to regenerate the protobuf stubs: make proto-api-v3-python (from the repository root)"

.PHONY: test
test:
	$(UV) pytest -q

# Starts OpenSearch and a Jaeger built from this tree, then runs the end-to-end test
# against them. Needs docker and go; everything it starts, it stops.
.PHONY: e2e
e2e:
	./e2e/run.sh

.PHONY: lint
lint:
	$(UV) ruff check src tests examples
	$(UV) pyright
	$(UV) ruff format --check src tests examples

.PHONY: fmt
fmt:
	$(UV) ruff check --fix src tests examples
	$(UV) ruff format src tests examples

.PHONY: lock
lock:
	uv lock

.PHONY: clean
clean:
	rm -rf .venv .pytest_cache .ruff_cache src/*.egg-info
	find . -name __pycache__ -type d -prune -exec rm -rf {} +
